# Configuración del alojamiento estático (ADR-020 §2). Se copia al build y se sube con él.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Una sola página: cualquier ruta que no sea un fichero existente devuelve index.html. Sin esto, recargar
  # una ruta profunda daría 404 del servidor en vez de la aplicación.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Los ficheros con huella en el nombre (main-XXXXXXXX.js) no cambian nunca: se cachean para siempre.
  <FilesMatch "\-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html sí cambia en cada publicación: nunca se cachea, o el navegador serviría la versión vieja.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # La página no carga nada de terceros y no queremos que pueda empezar a hacerlo por accidente
  # (ADR-020 §13). `connect-src` deja salir solo a la API del observatorio.
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://observatorio-production-ed20.up.railway.app; frame-ancestors 'none'; base-uri 'self'"
  Header set Referrer-Policy "no-referrer"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
